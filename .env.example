# Copy this file to .env and fill in only the providers you want to use.

# Provider routing: openai, anthropic, or google. The primary provider is tried
# first; fallbacks are used if the primary fails (e.g. rate limit, invalid model).
WIRELESS_TAXONOMY_LLM_PROVIDER=google
WIRELESS_TAXONOMY_LLM_FALLBACKS=openai,anthropic

# Default model choices. These are the current stable model IDs as of mid-2026;
# update them if provider API IDs change.
WIRELESS_TAXONOMY_OPENAI_MODEL=gpt-4.1-mini
WIRELESS_TAXONOMY_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
WIRELESS_TAXONOMY_GOOGLE_MODEL=gemini-3.5-flash

# Optional LLM request bounds.
WIRELESS_TAXONOMY_LLM_MAX_TOKENS=16000
WIRELESS_TAXONOMY_LLM_TIMEOUT_SECONDS=120

# Optional evidence log override. Defaults near the selected SQLite DB.
# WIRELESS_TAXONOMY_EVIDENCE_DIR=evidence

# Fetch/resolver credentials. Semantic Scholar is strongly recommended for
# DOI/title -> open-access PDF discovery. Unpaywall requires an email, not a key.
SEMANTIC_SCHOLAR_API_KEY=
# S2_API_KEY is also accepted if SEMANTIC_SCHOLAR_API_KEY is unset.
S2_API_KEY=

# OpenAlex and Unpaywall require a contact email for their "polite" API pool.
# Without this, the OA resolver falls back to less reliable rate-limited
# endpoints and fetch-coverage may fail or take 10+ minutes per venue.
WIRELESS_TAXONOMY_CONTACT_EMAIL=
WIRELESS_TAXONOMY_UNPAYWALL_EMAIL=
# UNPAYWALL_EMAIL is also accepted if WIRELESS_TAXONOMY_UNPAYWALL_EMAIL is unset.
UNPAYWALL_EMAIL=

# CORE (core.ac.uk) — free aggregator of ~300M open-access works from
# institutional repositories. When set, it runs after the OA indexes and
# before paid web search, absorbing most of the residual for free. Every hit
# is downloaded + title-verified before being trusted.
# Free key: https://core.ac.uk/services/api
CORE_API_KEY=

# Brave Search API (for --web-search PDF discovery). Preferred web-search
# provider: whole-web independent index, free tier 2K queries/month (1 req/s),
# then $5/1K. Every hit is downloaded + title-verified before being trusted.
# Key: https://brave.com/search/api ("Data for Search" plan)
BRAVE_SEARCH_API_KEY=
# WIRELESS_TAXONOMY_BRAVE_MAX_QUERIES=3000

# Google Programmable Search (optional extra --web-search layer). Note Google
# deprecated whole-web CSEs: new engines only search domains you whitelist
# (max 50), so Brave is preferred. Runs after Brave when both are configured.
# When neither Brave nor CSE is set, --web-search falls back to Gemini
# grounding (less reliable).
# Key:  https://console.cloud.google.com (enable "Custom Search API")
# ID:   https://programmablesearchengine.google.com
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# LLM API keys. Leave blank for providers you do not use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted for Google if GEMINI_API_KEY is unset.
GOOGLE_API_KEY=
